pkgname=flair
pkgver=0.2.0
pkgrel=1
pkgdesc='File explorer that summarizes, finds by meaning, sorts and answers with AI'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-webengine' 'qt6-multimedia' 'qt6-wayland' 'git')
optdepends=('poppler: résumer et indexer les PDF'
            'github-cli: cloner avec gh'
            'ollama: modèle IA local')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/flair "$pkgdir/usr/bin/flair"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/flair.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/flair.svg"
  for size in 16 24 32 48 64 128 256 512; do
    install -Dm644 "$startdir/icons/flair-$size.png" "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/flair.png"
  done
  install -Dm644 "$startdir/flair.desktop" "$pkgdir/usr/share/applications/flair.desktop"
  # Flair Image and Flair Vidéo: the same binary in other modes.
  for app in flair-image flair-video; do
    install -Dm644 "$startdir/$app.desktop" "$pkgdir/usr/share/applications/$app.desktop"
    install -Dm644 "$startdir/$app.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/$app.svg"
    for size in 16 24 32 48 64 128 256 512; do
      install -Dm644 "$startdir/icons/$app-$size.png" "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/$app.png"
    done
  done
}

pkgname=flair
pkgver=0.1.0
pkgrel=1
pkgdesc='File explorer that summarizes, finds by meaning, sorts and answers with AI'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'git')
optdepends=('poppler: résumer et indexer les PDF'
            'github-cli: cloner avec gh'
            'ollama: modèle IA local')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/flair "$pkgdir/usr/bin/flair"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/flair.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/flair.svg"
  install -Dm644 "$startdir/flair.desktop" "$pkgdir/usr/share/applications/flair.desktop"
}

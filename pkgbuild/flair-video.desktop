[Desktop Entry]
Type=Application
Name=Flair Vidéo
GenericName=Lecteur vidéo et audio
Comment=Les vidéos et la musique d'un dossier, au clavier, en plein écran
Keywords=vidéo;video;musique;music;lecteur;player;audio;
Exec=flair --video %f
TryExec=flair
Icon=/usr/share/icons/hicolor/scalable/apps/flair-video.svg
Terminal=false
Categories=AudioVideo;Video;Audio;Player;
MimeType=video/mp4;video/webm;video/x-matroska;video/quicktime;video/x-msvideo;video/mpeg;audio/mpeg;audio/flac;audio/ogg;audio/x-wav;audio/mp4;audio/aac;audio/opus;
StartupWMClass=flair-video
StartupNotify=true
